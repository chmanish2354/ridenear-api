generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  passwordHash String
  defaultLat   Float
  defaultLng   Float
  createdAt    DateTime      @default(now())
  reservations Reservation[]
}

model Vehicle {
  id              String        @id @default(uuid()) @db.Uuid
  make            String
  model           String
  year            Int
  type            String
  transmission    String
  fuel            String
  seats           Int
  pricePerDay     Int
  securityDeposit Int
  status          String
  currentLat      Float
  currentLng      Float
  anchorLat       Float
  anchorLng       Float
  imageUrl        String        @default("")
  updatedAt       DateTime      @updatedAt
  reservations    Reservation[]

  @@index([status])
}

model Reservation {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  vehicleId  String   @db.Uuid
  startAt    DateTime
  endAt      DateTime
  dayCount   Int
  pricePerDay Int
  totalPrice Int
  currency   String
  status     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, status, startAt, endAt])
}
